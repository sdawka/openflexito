[connection]
id=openflexito-hotspot
uuid=5f4b8a7e-1c2d-4e3f-9a8b-7c6d5e4f3a2b
type=wifi
autoconnect=false

[wifi]
mode=ap
ssid=microscope
band=bg
channel=6

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
group=ccmp
psk=microscope

[ipv4]
method=shared
address1=10.42.0.1/24

[ipv6]
method=ignore
