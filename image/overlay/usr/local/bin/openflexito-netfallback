#!/bin/sh
# Hotspot fallback: if neither a cable nor a WiFi client connection carries traffic, start the
# hotspot; while the hotspot is up, periodically drop it to give known networks a chance to
# reconnect. An Ethernet link with an IPv4 address (DHCP from a router, or link-local from a cable
# straight into a laptop) counts as connected, so a wired microscope never opens the hotspot.
set -u
HOTSPOT=openflexito-hotspot
active_wifi_client() {
    nmcli -t -f NAME,TYPE connection show --active | grep -E ':(802-11-wireless|wifi)$' | grep -v "^$HOTSPOT:" -q
}
active_ethernet() {
    for dev in $(nmcli -t -f DEVICE,TYPE,STATE device status | awk -F: '$2 ~ /ethernet/ && $3 ~ /^connected/ {print $1}'); do
        nmcli -t -f IP4.ADDRESS device show "$dev" | grep -q '^IP4.ADDRESS' && return 0
    done
    return 1
}
hotspot_up() {
    nmcli -t -f NAME connection show --active | grep -qx "$HOTSPOT"
}
if active_ethernet || active_wifi_client; then
    if hotspot_up; then nmcli connection down "$HOTSPOT" >/dev/null 2>&1 || true; fi
    exit 0
fi
if hotspot_up; then
    # Retry known networks every run (timer decides cadence): drop hotspot, scan, reconnect.
    nmcli connection down "$HOTSPOT" >/dev/null 2>&1 || true
    nmcli device wifi rescan >/dev/null 2>&1 || true
    sleep 20
    if active_ethernet || active_wifi_client; then exit 0; fi
fi
nmcli connection up "$HOTSPOT" >/dev/null 2>&1 && echo "hotspot started" || echo "hotspot failed"
